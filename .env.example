# Скопируйте в .env (он в .gitignore и не попадает в репозиторий) и заполните.
# Сервер читает переменные окружения; для systemd/Docker передайте их туда.

PORT=3000
HOST=0.0.0.0

# Публичный адрес сайта без слэша в конце — для canonical, sitemap и ссылок в уведомлениях
SITE_URL=https://example.ru

# Токен входа в /admin. Без него админка выключена. Длинная случайная строка:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Уведомления о заявках в Telegram. Создайте бота у @BotFather, узнайте chat_id
# (напишите боту и откройте https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Номер счётчика Яндекс.Метрики (необязательно)
METRIKA_ID=

# 1, если сайт стоит за nginx и клиентский IP приходит в X-Forwarded-For
TRUST_PROXY=0

# Куда писать данные (брони, заявки, рекорды). По умолчанию ./data
# DATA_DIR=/var/lib/holodnaya-gora
